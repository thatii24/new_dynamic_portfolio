# Email Delivery Configuration for Freelance Contact Form
# Copy this file to .env.local and fill in your values

# 1. Receiver Email: The email address where you want to receive project inquiries
CONTACT_RECEIVER_EMAIL=thatilawijayathunga@gmail.com

# 2. Public Display Contact Info (Optional)
NEXT_PUBLIC_CONTACT_EMAIL=thatilawijayathunga@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+94 78 1263 743

# 2. SMTP Provider Settings (Option A: Gmail SMTP - Recommended)
# For Gmail: Use your Gmail address and a 16-character 'App Password'
# (Generate one at: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thatilawijayathunga@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# 3. Alternative Custom SMTP (Option B)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your-smtp-password
