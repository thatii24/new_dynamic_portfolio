# Next.js & Node.js Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
# Ensure template is tracked, but real secrets are ignored
!.env.example

# Next.js Build Outputs
/.next/
/out/
/build/
/dist/

# Security Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing & Coverage
/coverage
/.nyc_output

# IDE & OS Metadata
.DS_Store
Thumbs.db
*.tsbuildinfo
next-env.d.ts
.vercel

# Editor directories (optional)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
